{
        "version": "2.0.0",
        "tasks": [
                {
                        "type": "shell",
                        "label": "C/C++: compilar archivo activo → build/",
                        "command": "mkdir -p ${fileDirname}/build && gcc -Wall -Wextra -g -fdiagnostics-color=always ${file} -o ${fileDirname}/build/${fileBasenameNoExtension}",
                        "options": {
                                "cwd": "${fileDirname}"
                        },
                        "problemMatcher": [
                                "$gcc"
                        ],
                        "group": {
                                "kind": "build",
                                "isDefault": false
                        },
                        "detail": "Compila el archivo activo en su carpeta build/ local."
                },
                {
                        "type": "shell",
                        "label": "Make: compilar capítulo completo",
                        "command": "make",
                        "options": {
                                "cwd": "${fileDirname}/.."
                        },
                        "problemMatcher": [
                                "$gcc"
                        ],
                        "group": "build",
                        "detail": "Ejecuta make en la carpeta del capítulo para compilar todos los temas."
                },
                {
                        "type": "shell",
                        "label": "Make: compilar TODO el proyecto",
                        "command": "make",
                        "options": {
                                "cwd": "${workspaceFolder}"
                        },
                        "problemMatcher": [
                                "$gcc"
                        ],
                        "group": "build",
                        "detail": "Ejecuta make desde la raíz del workspace para compilar todos los capítulos."
                },
                {
                        "type": "cppbuild",
                        "label": "C/C++: gcc compilar archivo activo",
                        "command": "/usr/bin/gcc",
                        "args": [
                                "-fdiagnostics-color=always",
                                "-g",
                                "${file}",
                                "-o",
                                "${fileDirname}/${fileBasenameNoExtension}"
                        ],
                        "options": {
                                "cwd": "${fileDirname}"
                        },
                        "problemMatcher": [
                                "$gcc"
                        ],
                        "group": {
                                "kind": "build",
                                "isDefault": true
                        },
                        "detail": "Tarea generada por el depurador."
                }
        ]
}